{
  "title": "Synthetic Runtime Diagnosis Plan",
  "type": "object",
  "required": ["schema_version", "case_id", "authority", "observations", "inferences", "runtime_identity", "freshness", "correlation", "assertions", "minimal_evidence", "next_observations"],
  "properties": {
    "schema_version": {"const": "diagnosis_plan/v1"},
    "case_id": {"type": "string", "minLength": 1},
    "authority": {
      "type": "object",
      "required": ["allowed_observations", "prohibited_mutations", "proposed_operations"],
      "properties": {
        "allowed_observations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "prohibited_mutations": {"type": "array", "items": {"type": "string"}},
        "proposed_operations": {"type": "array", "items": {"type": "object", "required": ["operation", "kind", "authorized"], "properties": {"operation": {"type": "string"}, "kind": {"enum": ["read", "mutation"]}, "authorized": {"type": "boolean"}}}}
      }
    },
    "observations": {"type": "array", "minItems": 1},
    "inferences": {"type": "array", "minItems": 1},
    "runtime_identity": {"type": "object", "required": ["fields", "source", "status"]},
    "freshness": {"type": "object", "required": ["assessment", "evidence_basis", "status"]},
    "correlation": {"type": "object", "required": ["method", "timezone_handling", "status"]},
    "assertions": {"type": "array", "minItems": 2},
    "visibility_gaps": {"type": "array"},
    "minimal_evidence": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "next_observations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
